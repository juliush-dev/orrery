{
  "name": "@juliush-dev/orrery",
  "version": "0.1.0",
  "description": "Build operable models: a stage that pans and zooms, a text layer floating over it, and laws that keep both honest.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "orrery": "src/build.mjs"
  },
  "scripts": {
    "build:example": "node src/build.mjs example/example.src.html example/dist/index.html",
    "build:depth": "node src/build.mjs example/depth.src.html example/dist/depth.html",
    "build:model": "node src/build.mjs example/model.src.html example/dist/model.html",
    "build:context": "node src/build.mjs example/context.src.html example/dist/context.html",
    "check:context": "node check/context.mjs",
    "check:panels": "node check/panels.mjs",
    "check": "node check/verify.mjs example/dist",
    "check:depth": "node check/depth.mjs",
    "check:affordances": "node check/affordances.mjs",
    "check:enter-motion": "node check/enter-motion.mjs",
    "check:model": "node check/model.mjs",
    "check:order": "node check/order.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@material-symbols/svg-400": "^0.14.0",
    "@material/material-color-utilities": "0.2.7"
  },
  "devDependencies": {
    "playwright-core": "^1.0.0"
  }
}
